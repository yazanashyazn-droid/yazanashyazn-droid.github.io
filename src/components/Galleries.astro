---
// One native <dialog> per project = the "Discover more" gallery. Its images sit in a <template>
// that main.ts mounts on first open, so nothing downloads until a gallery is opened.
import { Image } from 'astro:assets';
import { useT, pick, type Lang } from '../i18n/ui';
import { projects, img } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

{
  projects.map((p, i) => {
    const prev = projects[(i - 1 + projects.length) % projects.length];
    const next = projects[(i + 1) % projects.length];
    return (
      <dialog class="gallery" id={`work-${p.id}`} aria-labelledby={`gt-${p.id}`} data-gallery={p.id} data-lenis-prevent>
        <div class="gallery__bar">
          <span class="gallery__count tech" dir="ltr">
            {String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}
          </span>
          <form method="dialog">
            <button class="pill pill--accent gallery__close" type="submit" aria-label={t('work.close')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" />
              </svg>
              <span class="gallery__close-text">{t('work.close')}</span>
            </button>
          </form>
        </div>

        <div class="gallery__body container">
          <header class="gallery__head">
            <span class="kicker">{pick(p.category, lang)}</span>
            <h2 class="gallery__title display" id={`gt-${p.id}`}>
              {pick(p.title, lang)}
            </h2>
            <p class="gallery__summary">{pick(p.summary, lang)}</p>
            {p.palette && (
              <div class="palette">
                <p class="palette__label">{t('work.palette')}</p>
                <ul class="palette__list">
                  {p.palette.map((hex) => (
                    <li>
                      <button
                        type="button"
                        class="swatch"
                        data-copy={hex}
                        data-copied={t('work.copied')}
                      >
                        <span class="swatch__chip" aria-hidden="true" />
                        <span class="tech">{hex}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </header>

          {/* Inert until opened: images inside a <template> are never fetched up front */}
          <template data-gallery-items>
          <ul class="gallery__grid">
            {p.items.map((item) => (
              <li class:list={['card', { 'card--wide': item.wide }]}>
                <figure class="paper">
                  <span class="tape card__tape" aria-hidden="true" />
                  {item.before ? (
                    <div class="compare" data-compare>
                      <Image src={img(item.image)} alt={`${pick(item.title, lang)} — ${t('work.after')}`} widths={[800, 1600]} sizes="(min-width: 1024px) 70vw, 92vw" loading="lazy" />
                      <div class="compare__before">
                        <Image src={img(item.before)} alt={`${pick(item.title, lang)} — ${t('work.before')}`} widths={[800, 1600]} sizes="(min-width: 1024px) 70vw, 92vw" loading="lazy" />
                      </div>
                      <span class="compare__line" aria-hidden="true" />
                      <span class="compare__tag compare__tag--before">{t('work.before')}</span>
                      <span class="compare__tag compare__tag--after">{t('work.after')}</span>
                      <input class="compare__range" type="range" min="0" max="100" value="50" aria-label={t('work.compare')} />
                    </div>
                  ) : (
                    <Image
                      src={img(item.image)}
                      alt={pick(item.title, lang)}
                      widths={item.wide ? [800, 1600, 2400] : [480, 960]}
                      sizes={item.wide ? '(min-width: 1024px) 80vw, 92vw' : '(min-width: 1024px) 40vw, 92vw'}
                      loading="lazy"
                    />
                  )}
                  <figcaption>{pick(item.title, lang)}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
          </template>

          <nav class="gallery__nav" aria-label={t('work.more')}>
            <a href={`#work-${prev.id}`} data-gallery-open={prev.id} class="gallery__nav-link">
              <span class="gallery__nav-label">{t('work.prev')}</span>
              <span class="display">{pick(prev.title, lang)}</span>
            </a>
            <a href={`#work-${next.id}`} data-gallery-open={next.id} class="gallery__nav-link gallery__nav-link--next">
              <span class="gallery__nav-label">{t('work.next')}</span>
              <span class="display">{pick(next.title, lang)}</span>
            </a>
          </nav>
        </div>
      </dialog>
    );
  })
}

<style>
  .gallery {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--text);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid-line-dark) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line-dark) 1px, transparent 1px);
    background-size: 32px 32px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .gallery[open] {
    animation: gallery-in 0.6s var(--ease-out);
  }

  .gallery::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  @keyframes gallery-in {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .gallery__bar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-4) var(--gutter);
    background: linear-gradient(var(--bg) 40%, transparent);
  }

  .gallery__count {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .gallery__body {
    padding-bottom: var(--sp-16);
  }

  .gallery__head {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-8) var(--sp-16);
    max-width: 60rem;
  }

  .gallery__title {
    font-size: var(--fs-3xl);
  }

  .gallery__summary {
    font-size: var(--fs-md);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .palette__label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin-bottom: var(--sp-2);
  }

  .palette__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .swatch {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: var(--sp-1) var(--sp-3) var(--sp-1) var(--sp-1);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.04);
    font-size: var(--fs-xs);
    transition: background-color var(--dur-base);
  }

  .swatch:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .swatch__chip {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--c);
    border: 2px solid var(--paper);
  }

  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .card--wide {
    grid-column: 1 / -1;
  }

  .card figure {
    --tilt: -1.2deg;
    margin: 0;
    rotate: var(--tilt);
    transition: rotate var(--dur-slow) var(--ease-out);
  }

  .card:nth-child(even) figure {
    --tilt: 1.2deg;
  }

  .card figure:hover {
    rotate: 0deg;
  }

  .card :global(img) {
    width: 100%;
    background: var(--paper-100);
  }

  .card__tape {
    top: -16px;
    left: 50%;
    translate: -50% 0;
    rotate: 3deg;
  }

  .card figcaption {
    padding-top: var(--sp-3);
    color: var(--ink-900);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* Before / after comparison */
  .compare {
    --pos: 50%;
    position: relative;
    overflow: hidden;
  }

  .compare__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .compare__before :global(img) {
    height: 100%;
    object-fit: cover;
  }

  .compare__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: var(--accent);
    pointer-events: none;
  }

  .compare__line::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.4);
  }

  .compare__tag {
    position: absolute;
    top: var(--sp-4);
    padding: var(--sp-1) var(--sp-3);
    background: var(--paper);
    color: var(--ink-900);
    font-size: var(--fs-xs);
    font-weight: 700;
    pointer-events: none;
  }

  .compare__tag--before {
    left: var(--sp-4);
  }

  .compare__tag--after {
    right: var(--sp-4);
  }

  .compare__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    direction: ltr;
  }

  .compare:has(.compare__range:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .gallery__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-top: var(--sp-24);
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .gallery__nav-link {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-8);
    text-decoration: none;
  }

  .gallery__nav-link--next {
    text-align: end;
  }

  .gallery__nav-label {
    font-size: var(--fs-sm);
    color: var(--accent);
  }

  .gallery__nav-link .display {
    font-size: var(--fs-xl);
    transition: color var(--dur-base);
  }

  .gallery__nav-link:hover .display {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .gallery__close-text {
      display: none;
    }
    .gallery__close {
      padding-inline: var(--sp-3);
    }
  }
</style>
