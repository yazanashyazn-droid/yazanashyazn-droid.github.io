---
// Big statement with image "pills" set inside the sentence ({0}, {1}, {2} in the copy).
// Pills keep a fixed size (only their content is revealed) so lines never re-wrap
// while scrolling; *starred* words get a coral highlighter that sweeps in.
import { Image } from 'astro:assets';
import { useT, type Lang } from '../i18n/ui';
import { img } from '../data/works';

interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
const pills = [
  { src: 'works/3d/perfume.webp', tone: 'coral' },
  { src: 'logos/haykal.webp', tone: 'blue' },
  { src: 'works/smash/phone.webp', tone: 'paper' },
];

type Part = { pill: number } | { word: string; key: boolean };
let open = false;
const parts: Part[] = t('statement2')
  .split(/(\{\d\})/)
  .flatMap((chunk): Part[] => {
    const m = chunk.match(/^\{(\d)\}$/);
    if (m) return [{ pill: Number(m[1]) }];
    return chunk
      .split(/\s+/)
      .filter(Boolean)
      .map((raw) => {
        const stars = (raw.match(/\*/g) ?? []).length;
        const key = open || stars > 0;
        if (stars % 2) open = !open;
        return { word: raw.replaceAll('*', ''), key };
      });
  });
---

<section class="statement" id="statement" aria-label={t('nav.about')}>
  <p class="statement__text display" data-statement>
    {
      parts.map((p) =>
        'pill' in p ? (
          <>
            <span class={`pill-media pill-media--${pills[p.pill].tone}`} aria-hidden="true" data-pill>
              <Image src={img(pills[p.pill].src)} alt="" widths={[200, 400]} sizes="160px" />
            </span>{' '}
          </>
        ) : (
          <>
            <span class:list={['w', { 'w--key': p.key }]}>
              {p.key && <span class="hl" aria-hidden="true" data-hl />}
              <span class="w__t">{p.word}</span>
            </span>{' '}
          </>
        ),
      )
    }
  </p>
</section>

<style>
  .statement {
    position: relative;
    padding: clamp(6rem, 14vw, 11rem) var(--gutter);
    background: var(--ink-900);
    border-top: 1px solid rgb(255 255 255 / 0.06);
  }

  .statement__text {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(2.4rem, 1rem + 5.4vw, 6.4rem);
    line-height: 1.08;
    text-align: center;
    color: var(--paper);
  }

  .statement__text:lang(ar) {
    line-height: 1.5;
  }

  .w {
    position: relative;
    display: inline-block;
  }

  .w__t {
    position: relative;
    z-index: 1;
    transition: color 0.3s;
  }

  :global(.js) .w {
    opacity: 0.16;
  }

  /* Coral highlighter behind key words */
  .hl {
    position: absolute;
    inset: 12% -0.08em 8%;
    z-index: 0;
    background: var(--accent);
    transform-origin: left center;
    rotate: -1.5deg;
  }

  :global([dir='rtl']) .hl {
    transform-origin: right center;
  }

  .w--key .w__t {
    color: var(--ink-900);
  }

  .pill-media {
    display: inline-block;
    width: 2.1em;
    height: 0.82em;
    vertical-align: -0.06em;
    border-radius: 999px;
    border: 0.09em solid;
    overflow: hidden;
    background: var(--ink-700);
  }

  .pill-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pill-media--coral { border-color: var(--accent); }
  .pill-media--blue { border-color: var(--accent-2); }
  .pill-media--paper { border-color: var(--paper); }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .w {
      opacity: 1;
    }
  }
</style>
