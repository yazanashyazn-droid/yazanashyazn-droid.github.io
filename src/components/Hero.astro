---
// Bento hero after chandebootcamp.com: work cards, live pixel fields and the big title.
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { useT, pick, type Lang } from '../i18n/ui';
import { projects, img } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const byId = (id: string) => projects.find((p) => p.id === id)!;
const cards = [
  { p: byId('smash'), area: 'c1', tone: 'ink' },
  { p: byId('nawaf'), area: 'c2', tone: 'coral' },
  { p: byId('afia'), area: 'c3', tone: 'blue' },
  { p: byId('logos'), area: 'c4', tone: 'paper' },
];
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="bento">
    <div class="cell info" data-bento>
      <div class="info__top">
        <span class="tech info__year" dir="ltr">(©26)</span>
      </div>
      <div class="info__body">
        <p class="info__date">{t('hero.date')}</p>
        <p class="info__city">{t('about.location')}</p>
        <p class="info__text">{t('hero.info')}</p>
        <a class="reel" href="#work" data-perch>
          <Image src={img('works/smash/table.webp')} alt="" widths={[240, 480]} sizes="200px" loading="eager" />
          <span class="reel__label">{t('hero.reel')}</span>
        </a>
      </div>
    </div>

    <div class="cell px" data-area="pxA" data-bento><canvas data-pixel="coral" aria-hidden="true"></canvas></div>
    <div class="cell px" data-area="pxB" data-bento><canvas data-pixel="blue" data-tile="16" aria-hidden="true"></canvas></div>
    <div class="cell px" data-area="pxC" data-bento><canvas data-pixel="coral" data-tile="12" aria-hidden="true"></canvas></div>
    <div class="cell px" data-area="pxD" data-bento><canvas data-pixel="cream" aria-hidden="true"></canvas></div>

    {
      cards.map(({ p, area, tone }, i) => (
        <a
          class={`cell card card--${tone}`}
          data-area={area}
          href={`#work-${p.id}`}
          data-gallery-open={p.id}
          data-cursor-label={t('work.view')}
          data-bento
          data-perch
        >
          <Image
            class="card__img"
            src={img(p.cover)}
            alt=""
            widths={[360, 720]}
            sizes="(min-width: 900px) 25vw, 50vw"
            loading="eager"
          />
          <span class="card__label">
            <span class="tech">{String(i + 1).padStart(2, '0')}</span>
            {pick(p.title, lang)}
          </span>
        </a>
      ))
    }

    <div class="cell title" data-bento>
      <Logo class="title__mark" wordmark={false} />
      <h1 class="title__h display" id="hero-title" dir="ltr">
        <span>{t('hero.titleA')}</span>
        <span>{t('hero.titleB')}</span>
        <span class="title__last">{t('hero.titleC')} <span class="title__c">(©26)</span></span>
        <span class="visually-hidden"> — {t('about.name')}</span>
      </h1>
    </div>
  </div>

  <a class="scroll-more" href="#statement">
    {t('hero.scrollMore')}
    <span class="scroll-more__dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink-900);
    padding-top: 56px;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    grid-template-areas:
      'info pxA pxB title'
      'info c1  pxB title'
      'info c1  c2  title'
      'info pxC c2  title'
      'info pxC c3  pxD'
      'info c4  c3  pxD';
    height: calc(100dvh - 56px);
    min-height: 620px;
  }

  .cell {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
  }

  /* grid-area via data attribute (inline styles are blocked by the CSP) */
  [data-area='pxA'] { grid-area: pxA; }
  [data-area='pxB'] { grid-area: pxB; }
  [data-area='pxC'] { grid-area: pxC; }
  [data-area='pxD'] { grid-area: pxD; }
  [data-area='c1'] { grid-area: c1; }
  [data-area='c2'] { grid-area: c2; }
  [data-area='c3'] { grid-area: c3; }
  [data-area='c4'] { grid-area: c4; }

  .px canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Room for the fixed side tab on the right edge */
  .info,
  .title {
    padding-right: 60px;
  }

  /* Info column */
  .info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-6) var(--sp-4);
    background: var(--ink-900);
    color: var(--paper);
    border-inline-end: 1px solid rgb(255 255 255 / 0.06);
  }

  .info__year {
    font-size: var(--fs-sm);
    color: var(--accent);
  }

  .info__body {
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
  }

  .info__date {
    color: var(--accent);
  }

  .info__text {
    font-weight: 400;
    color: var(--text-muted);
    text-transform: none;
    max-width: 28ch;
  }

  .reel {
    position: relative;
    display: block;
    width: min(100%, 200px);
    aspect-ratio: 16 / 10;
    margin-top: var(--sp-4);
    overflow: hidden;
  }

  .reel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .reel:hover :global(img) {
    transform: scale(1.08);
  }

  .reel__label {
    position: absolute;
    bottom: 0;
    inset-inline-start: 0;
    padding: 2px 8px;
    background: var(--accent);
    color: var(--ink-900);
    font-family: var(--font-tech);
    font-size: 0.65rem;
    font-weight: 700;
  }

  /* Work cards */
  .card {
    display: block;
    text-decoration: none;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s var(--ease-out),
      filter 0.5s;
  }

  .card:hover .card__img {
    transform: scale(1.06);
  }

  .card__label {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: padding 0.4s var(--ease-out);
  }

  .card:hover .card__label {
    padding-block: var(--sp-3);
  }

  .card--ink .card__label { background: var(--ink-900); color: var(--paper); }
  .card--coral .card__label { background: var(--accent); color: var(--ink-900); }
  .card--blue .card__label { background: var(--sticker); color: var(--paper); }
  .card--paper .card__label { background: var(--paper); color: var(--ink-900); }

  /* Title panel */
  .title {
    grid-area: title;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-6) var(--sp-4) var(--sp-4);
    background: var(--paper);
    color: var(--ink-900);
  }

  .title__mark {
    width: 46px;
  }

  .title__h {
    display: grid;
    font-size: clamp(2.6rem, 1rem + 4.2vw, 5.6rem);
    line-height: 0.88;
    text-align: start;
  }

  .title__last {
    color: var(--accent-on-cream);
  }

  .title__c {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.7em;
    color: var(--ink-900);
  }

  .scroll-more {
    position: absolute;
    bottom: var(--sp-4);
    inset-inline-start: 25%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-4);
    background: var(--ink-900);
    color: var(--paper);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  .scroll-more__dots {
    display: inline-flex;
    gap: 4px;
  }

  .scroll-more__dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    animation: dot 1.2s infinite;
  }

  .scroll-more__dots i:nth-child(2) { animation-delay: 0.15s; }
  .scroll-more__dots i:nth-child(3) { animation-delay: 0.3s; }

  @keyframes dot {
    50% {
      opacity: 0.2;
    }
  }

  /* Tablet / phone: title first, then a two-column mosaic */
  @media (max-width: 900px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto repeat(4, 34vw) auto;
      grid-template-areas:
        'title title'
        'c1    pxA'
        'c1    c2'
        'pxB   c2'
        'c3    c4'
        'info  info';
      height: auto;
      min-height: 0;
    }
    [data-area='pxC'],
    [data-area='pxD'] {
      display: none;
    }
    .title {
      gap: var(--sp-8);
      min-height: 62vw;
    }
    .title__h {
      font-size: clamp(3rem, 1rem + 11vw, 5rem);
    }
    .scroll-more {
      display: none;
    }
    .info {
      gap: var(--sp-6);
    }
  }
</style>
