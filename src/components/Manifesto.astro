---
// Manifesto, the ring "eyes" (pupil = YZN logo dot) and the roles list.
import { Image } from 'astro:assets';
import Title from './Title.astro';
import { useT, pick, roles, type Lang } from '../i18n/ui';
import { img } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// "(words in brackets)" render in the light weight, like the reference
const chunks = t('manifesto').split(/(\([^)]*\))/).filter(Boolean);
const eyes = ['eye--a', 'eye--b', 'eye--c'];
---

<section class="mani" id="services" aria-labelledby="mani-title">
  <div class="mani__top">
    <h2 class="mani__text display" id="mani-title" data-reveal>
      {chunks.map((c) => (c.startsWith('(') ? <span class="paren">{c}</span> : c))}
    </h2>
    <div class="mani__aside">
      <div class="mani__thumb" data-perch data-reveal>
        <Image src={img('works/nawaf/stationery.webp')} alt="" widths={[300, 600]} sizes="260px" />
      </div>
      <p class="mani__side" data-reveal>{t('manifesto.side')}</p>
    </div>
  </div>

  <div class="eyes" aria-hidden="true">
    {
      eyes.map((cls) => (
        <div class={`eye ${cls}`} data-eye data-perch>
          <span class="eye__iris">
            <span class="eye__pupil" data-pupil>
              <span class="eye__glint" />
            </span>
          </span>
        </div>
      ))
    }
  </div>

  <div class="roles">
    <p class="roles__text" data-reveal>
      <span class="kicker">{t('roles.kicker')}</span>
      {t('roles.text')}
    </p>
    <div class="roles__img" data-reveal data-perch>
      <Image src={img('about/yazan.webp')} alt="" widths={[300, 600]} sizes="240px" />
    </div>
    <ul class="roles__list display">
      {roles.map((r) => <li data-reveal>{pick(r, lang)}</li>)}
    </ul>
    <p class="roles__end display" data-reveal><Title text={t('roles.end')} /></p>
  </div>
</section>

<style>
  .mani {
    position: relative;
    padding: clamp(5rem, 10vw, 8rem) var(--gutter);
    background-color: var(--surface-cream);
    color: var(--ink-900);
    overflow: hidden;
  }

  .mani__top {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: var(--sp-8);
    align-items: end;
    padding-bottom: var(--sp-12);
    border-bottom: 1px dashed var(--paper-300);
  }

  .mani__text {
    font-size: clamp(2rem, 1rem + 3.6vw, 4.4rem);
    line-height: 0.98;
  }

  .mani__text:lang(ar) {
    line-height: 1.45;
  }

  .paren {
    font-family: var(--font-sans);
    font-weight: 250;
    text-transform: none;
    color: var(--accent-on-cream);
  }

  .mani__aside {
    display: grid;
    gap: var(--sp-6);
  }

  .mani__thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .mani__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .mani__thumb:hover :global(img) {
    transform: scale(1.06);
  }

  .mani__side {
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* ---------- Eyes ---------- */
  .eyes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    padding-block: var(--sp-12);
    border-bottom: 1px dashed var(--paper-300);
  }

  .eye {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1;
    justify-self: center;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: transform 0.6s var(--ease-spring);
  }

  .eye:hover {
    transform: scale(1.04) rotate(-4deg);
  }

  .eye__iris {
    display: grid;
    place-items: center;
    width: 66%;
    height: 66%;
    border-radius: 50%;
  }

  /* The pupil is the YZN logo's coral dot */
  .eye__pupil {
    position: relative;
    width: 42%;
    height: 42%;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
  }

  .eye__glint {
    position: absolute;
    top: 18%;
    inset-inline-start: 22%;
    width: 22%;
    height: 22%;
    border-radius: 50%;
    background: var(--paper);
    opacity: 0.85;
  }

  .eye--a { grid-column: 1; background: var(--accent); }
  .eye--a .eye__iris { background: var(--ink-900); }
  .eye--b { grid-column: 3; background: var(--sticker); }
  .eye--b .eye__iris { background: var(--paper); }
  .eye--c { grid-column: 4; background: var(--ink-900); }
  .eye--c .eye__iris { background: var(--accent-2); }

  /* ---------- Roles ---------- */
  .roles {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr);
    grid-template-areas:
      'text img list'
      '.    .   end';
    gap: var(--sp-8);
    padding-top: var(--sp-12);
  }

  .roles__text {
    grid-area: text;
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    font-size: var(--fs-sm);
    color: var(--text-on-cream-muted);
  }

  .roles__img {
    grid-area: img;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--accent);
    align-self: start;
  }

  .roles__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .roles__list {
    grid-area: list;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: clamp(2rem, 1rem + 3vw, 3.6rem);
    line-height: 1;
  }

  .roles__list:lang(ar) {
    line-height: 1.3;
  }

  .roles__list li {
    transition:
      color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .roles__list li:hover {
    color: var(--accent-on-cream);
    transform: translateX(0.4em);
  }

  :global([dir='rtl']) .roles__list li:hover {
    transform: translateX(-0.4em);
  }

  .roles__end {
    grid-area: end;
    justify-self: end;
    text-align: end;
    font-size: var(--fs-xl);
  }

  @media (max-width: 900px) {
    .mani__top {
      grid-template-columns: 1fr;
    }
    .eyes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-3);
    }
    .eye--a { grid-column: 1; }
    .eye--b { grid-column: 2; }
    .eye--c { grid-column: 3; }
    .roles {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'text img'
        'list list'
        'end  end';
    }
  }
</style>
