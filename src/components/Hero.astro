---
import { Image } from 'astro:assets';
import { useT, type Lang } from '../i18n/ui';
import paper from '../assets/texture/paper-dark.webp';
import ruler from '../assets/hero/ruler.webp';
import laptop from '../assets/hero/laptop.webp';
import palette from '../assets/hero/palette.webp';
import headphones from '../assets/hero/headphones.webp';

interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);

// Desk objects from the PDF cover. `depth` drives mouse parallax and scroll scatter.
const objects = [
  { src: ruler, cls: 'obj--ruler', depth: 0.6, w: 520 },
  { src: laptop, cls: 'obj--laptop', depth: 0.9, w: 720 },
  { src: palette, cls: 'obj--palette', depth: 0.7, w: 560 },
  { src: headphones, cls: 'obj--headphones', depth: 1, w: 480 },
];
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__sticky">
    <Image class="hero__paper" src={paper} alt="" widths={[1200, 2400]} sizes="100vw" loading="eager" />
    <div class="hero__grid" aria-hidden="true"></div>

    {
      objects.map((o) => (
        <div class={`obj ${o.cls}`} data-hero-obj data-depth={o.depth} aria-hidden="true">
          <Image
            src={o.src}
            alt=""
            widths={[Math.round(o.w / 2), o.w]}
            sizes={`(min-width: 1024px) ${Math.round(o.w / 2)}px, 35vw`}
            loading="eager"
          />
        </div>
      ))
    }

    <div class="hero__title-wrap" data-hero-title>
      <span class="guide guide--h1" aria-hidden="true"></span>
      <span class="guide guide--h2" aria-hidden="true"></span>
      <span class="guide guide--h3" aria-hidden="true"></span>
      <span class="guide guide--v1" aria-hidden="true"></span>
      <span class="guide guide--v2" aria-hidden="true"></span>

      <h1 class="hero__title" id="hero-title" dir="ltr">
        <span class="hero__line hero__line--1">
          <span class="hero__kicker tech" data-hero-word>{t('hero.kicker')}</span>{" "}
          <span class="hero__design" data-hero-word>{t('hero.title1')}</span>
        </span>{" "}
        <span class="hero__portfolio display" data-hero-word>
          {t('hero.title2')}<span class="hero__diamond" aria-hidden="true"></span>
        </span>
        {" "}<span class="hero__year tech" data-hero-word>{t('hero.year')}</span>
        <span class="visually-hidden"> — {t('about.name')}</span>
      </h1>
    </div>

    <div class="hero__foot container">
      <p class="hero__role" data-hero-foot>{t('hero.role')}</p>
      <a class="hero__scroll" href="#statement" data-hero-foot>
        <span>{t('hero.scroll')}</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 200vh;
    background: var(--bg-deep);
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    min-height: 560px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .hero__paper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line-dark) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line-dark) 1px, transparent 1px);
    background-size: 36px 36px;
  }

  .obj {
    position: absolute;
    z-index: 1;
    will-change: transform;
  }

  .obj :global(img) {
    width: 100%;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
  }

  .obj--ruler {
    width: clamp(150px, 24vw, 340px);
    top: -2%;
    left: -4%;
    rotate: 8deg;
  }

  .obj--laptop {
    width: clamp(200px, 34vw, 520px);
    top: -14%;
    right: -6%;
    rotate: -28deg;
  }

  .obj--palette {
    width: clamp(170px, 26vw, 380px);
    bottom: -10%;
    left: -5%;
    rotate: 14deg;
  }

  .obj--headphones {
    width: clamp(150px, 22vw, 320px);
    bottom: -8%;
    right: -2%;
    rotate: -18deg;
  }

  .hero__title-wrap {
    position: relative;
    z-index: 2;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 4vw, 3rem);
  }

  .hero__title {
    display: grid;
    justify-items: center;
    color: var(--white);
    line-height: 0.9;
    font-weight: 400;
  }

  .hero__line--1 {
    display: flex;
    align-items: flex-end;
    gap: 0.15em;
    margin-inline-start: 18%;
  }

  .hero__kicker {
    font-size: clamp(1.1rem, 0.6rem + 2.2vw, 3rem);
    font-weight: 400;
    padding-bottom: 0.35em;
  }

  .hero__design {
    font-size: clamp(2.8rem, 1.2rem + 7vw, 8.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero__portfolio {
    position: relative;
    font-size: var(--fs-display);
    color: var(--accent);
    line-height: 0.85;
    letter-spacing: 0.005em;
  }

  .hero__diamond {
    position: absolute;
    top: 0.06em;
    right: 0.32em;
    width: 0.13em;
    height: 0.13em;
    background: var(--accent);
    rotate: 45deg;
    display: none;
  }

  .hero__year {
    justify-self: end;
    font-size: clamp(0.9rem, 0.5rem + 1.4vw, 1.9rem);
    font-weight: 700;
    color: var(--accent-2);
    margin-top: 0.3em;
  }

  /* Dashed Illustrator guides around the title */
  .guide {
    position: absolute;
    pointer-events: none;
    --dash: repeating-linear-gradient(90deg, var(--guide) 0 10px, transparent 10px 18px);
  }

  .guide--h1,
  .guide--h2,
  .guide--h3 {
    left: -8%;
    right: -8%;
    height: 1px;
    background: var(--dash);
    transform-origin: left;
  }

  .guide--h1 {
    top: 6%;
  }
  .guide--h2 {
    top: 42%;
  }
  .guide--h3 {
    bottom: 14%;
  }

  .guide--v1,
  .guide--v2 {
    top: -6%;
    bottom: -6%;
    width: 1px;
    background: repeating-linear-gradient(180deg, var(--guide) 0 10px, transparent 10px 18px);
    transform-origin: top;
  }

  .guide--v1 {
    left: 5%;
  }
  .guide--v2 {
    right: 5%;
  }

  .hero__foot {
    position: absolute;
    z-index: 2;
    bottom: var(--sp-8);
    inset-inline: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    min-height: 44px;
  }

  .hero__scroll-line {
    width: 48px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: scroll-line 1.8s var(--ease-out) infinite;
  }

  @keyframes scroll-line {
    0% {
      transform: scaleX(0);
    }
    60% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .hero {
      height: 160vh;
    }
    .hero__role {
      display: none;
    }
    .hero__foot {
      justify-content: center;
    }
    .obj--laptop {
      top: -6%;
    }
    .obj--palette {
      bottom: -4%;
    }
    .obj--headphones {
      bottom: -2%;
    }
  }
</style>
