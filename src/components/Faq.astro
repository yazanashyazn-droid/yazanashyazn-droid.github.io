---
import { useT, pick, faq, type Lang } from '../i18n/ui';
import Title from './Title.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="faq bg-grid-dark" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <header class="faq__head" data-reveal>
      <span class="kicker">{t('faq.kicker')}</span>
      <h2 class="faq__title display" id="faq-title"><Title text={t('faq.title')} /></h2>
    </header>

    <div class="faq__list">
      {
        faq.map((item, i) => (
          <details class="qa" name="faq" open={i === 0} data-reveal>
            <summary class="qa__q">
              <span>{pick(item.q, lang)}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <div class="qa__a">
              <p>{pick(item.a, lang)}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .faq__grid {
    display: grid;
    gap: var(--sp-12);
  }

  .faq__head {
    display: grid;
    gap: var(--sp-4);
    align-content: start;
  }

  .faq__title {
    font-size: var(--fs-2xl);
  }

  .faq__list {
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .qa {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    interpolate-size: allow-keywords;
  }

  .qa::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }

  .qa[open]::details-content {
    block-size: auto;
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    min-height: 44px;
    padding-block: var(--sp-6);
    font-size: var(--fs-lg);
    font-weight: 600;
    list-style: none;
    transition: color var(--dur-base);
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__q:hover {
    color: var(--accent);
  }

  .qa__icon {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    transition:
      transform 0.4s var(--ease-out),
      background-color var(--dur-base);
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    background: currentColor;
  }

  .qa__icon::after {
    rotate: 90deg;
  }

  .qa[open] .qa__icon {
    transform: rotate(45deg);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink-900);
  }

  .qa__a {
    padding-bottom: var(--sp-6);
    color: var(--text-muted);
    max-width: 62ch;
  }

  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .faq__head {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
</style>
