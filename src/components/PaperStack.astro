---
// Pinned "paper stack": one 4:3 cover per project flies in and lands like printed paper.
// Everything sits in a grid so pieces can never land on top of each other or the title.
import { Image } from 'astro:assets';
import Title from './Title.astro';
import { useT, pick, type Lang } from '../i18n/ui';
import { projects, img } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const tones = ['coral', 'paper', 'blue', 'ink', 'coral', 'blue', 'paper'];
---

<section class="stack" id="work" data-stack aria-labelledby="stack-title">
  <div class="stack__stage">
    <header class="stack__head">
      <span class="kicker">{t('stack.kicker')}</span>
      <h2 class="stack__title display" id="stack-title"><Title text={t('stack.title')} /></h2>
      <p class="stack__hint">{t('stack.hint')}</p>
    </header>

    {
      projects.map((p, i) => (
        <a
          class={`piece pc-${i + 1}`}
          href={`#work-${p.id}`}
          data-gallery-open={p.id}
          data-piece
          data-cursor-label={t('work.view')}
        >
          <span class="piece__paper">
            <Image
              class="piece__img"
              src={img(p.cover)}
              alt={pick(p.title, lang)}
              widths={[480, 800, 1200]}
              sizes="(min-width: 901px) 24vw, (max-width: 600px) 46vw, 40vw"
            />
          </span>
          <span class={`piece__sticker sticker--${tones[i % tones.length]}`} data-sticker>
            {pick(p.category, lang)}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .stack {
    position: relative;
    height: 420vh;
    background-color: var(--surface-cream);
    overflow-x: clip;
  }

  .stack__stage {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-8);
    align-items: center;
    justify-items: center;
    /* 64px on the right keeps the last column clear of the fixed "available" tab */
    padding: 76px 64px var(--sp-6) var(--gutter);
    overflow: hidden;
    perspective: 1400px;
    background:
      radial-gradient(circle at 20% 30%, rgb(255 255 255 / 0.5), transparent 40%),
      repeating-linear-gradient(115deg, rgb(0 0 0 / 0.018) 0 2px, transparent 2px 9px),
      var(--surface-cream);
  }

  .stack__head {
    grid-column: 1;
    grid-row: 1;
    justify-self: stretch;
    display: grid;
    gap: var(--sp-3);
    color: var(--ink-900);
  }

  .stack__title {
    font-size: clamp(2rem, 1rem + 2.6vw, 3.6rem);
  }

  .stack__hint {
    font-size: var(--fs-sm);
    color: var(--text-on-cream-muted);
  }

  /* Width is also capped by the row height, so short screens never overlap */
  .piece {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, calc((100dvh - 150px) / 2 * 4 / 3));
    transform-style: preserve-3d;
    transform-origin: 50% 100%;
    text-decoration: none;
    will-change: transform;
  }

  .piece:hover,
  .piece:focus-visible {
    z-index: 2;
  }

  .pc-7 {
    grid-column: 1;
    grid-row: 2;
  }

  .pc-1 { rotate: -2deg; }
  .pc-2 { rotate: 1.5deg; }
  .pc-3 { rotate: -1deg; }
  .pc-4 { rotate: 2deg; }
  .pc-5 { rotate: -1.5deg; }
  .pc-6 { rotate: 1deg; }
  .pc-7 { rotate: -1.5deg; }

  .piece__paper {
    display: block;
    padding: 8px;
    background: var(--paper);
    box-shadow:
      0 30px 50px -22px rgb(0 0 0 / 0.45),
      0 2px 0 rgb(0 0 0 / 0.06);
    transition: transform 0.5s var(--ease-spring);
  }

  .piece:hover .piece__paper {
    transform: translateY(-6px) rotate(-0.6deg);
  }

  .piece__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--ink-700);
  }

  .piece__sticker {
    position: absolute;
    top: -12px;
    inset-inline-start: 10px;
    padding: 3px 12px;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 0.6rem + 0.5vw, 1.15rem);
    text-transform: uppercase;
    white-space: nowrap;
    rotate: -3deg;
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.25);
  }

  .piece__sticker:lang(ar) {
    font-weight: 700;
  }

  .sticker--coral { background: var(--accent); color: var(--ink-900); }
  .sticker--blue { background: var(--sticker); color: var(--paper); }
  .sticker--ink { background: var(--ink-900); color: var(--accent); }
  .sticker--paper { background: var(--paper); color: var(--ink-900); box-shadow: 0 0 0 2px var(--ink-900); }

  /* Phones and tablets: no pinning, a tidy two-column pile with the first cover full width */
  @media (max-width: 900px) {
    .stack {
      height: auto;
    }
    .stack__stage {
      position: relative;
      height: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: var(--sp-8) var(--sp-4);
      padding: 6rem var(--gutter) var(--sp-16);
      perspective: none;
    }
    .stack__head {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-bottom: var(--sp-2);
    }
    .piece {
      width: 100%;
    }
    .pc-1 {
      grid-column: 1 / -1;
    }
    .pc-7 {
      grid-column: auto;
      grid-row: auto;
    }
    .piece__sticker {
      top: -10px;
      inset-inline-start: 6px;
      font-size: 0.8rem;
      padding: 2px 8px;
    }
  }
</style>
