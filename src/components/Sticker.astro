---
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
const text = t('sticker');
// Each half of the track must be wider than the widest screen, so the -50% loop never shows a gap.
const group = Array.from({ length: 4 }, () => text);
---

<section class="sticker" aria-label={text}>
  <div class="band band--paper" aria-hidden="true">
    <div class="band__track">
      {[0, 1].map(() => <span class="band__group">{group.map((g) => <span class="display">{g}</span>)}</span>)}
    </div>
  </div>
  <div class="band band--blue">
    <span class="tape band__tape band__tape--start" aria-hidden="true"></span>
    <span class="tape band__tape band__tape--end" aria-hidden="true"></span>
    <div class="band__clip" aria-hidden="true">
      <div class="band__track">
        {[0, 1].map(() => <span class="band__group">{group.map((g) => <span class="display">{g}</span>)}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .sticker {
    position: relative;
    z-index: 2;
    display: grid;
    /* Without this the column grows to the marquee's max-content width */
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(4rem, 9vw, 8rem);
    overflow: hidden;
    background: var(--bg);
  }

  .band {
    grid-area: 1 / 1;
    position: relative;
    width: 130%;
    margin-inline-start: -15%;
    padding-block: clamp(0.8rem, 1.6vw, 1.4rem);
    overflow: hidden;
    box-shadow: var(--shadow-paper);
  }

  .band--paper {
    background: var(--paper);
    color: var(--accent-on-cream);
    rotate: 3deg;
  }

  .band--blue {
    background: var(--sticker);
    color: var(--paper);
    rotate: -4deg;
    overflow: visible;
  }

  .band__track {
    display: flex;
    width: max-content;
    animation: marquee 36s linear infinite;
  }

  .band--paper .band__track {
    animation-direction: reverse;
  }

  /* The blue band stays overflow-visible for its tape; the text is clipped here instead */
  .band__clip {
    overflow: hidden;
  }

  .band__group {
    display: flex;
    flex: none;
  }

  .band__track .display {
    font-size: clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-inline-end: 0.6em;
    white-space: nowrap;
  }

  :global([dir='rtl']) .band__track {
    animation-name: marquee-rtl;
  }

  .band__tape {
    top: -18px;
  }

  .band__tape--start {
    inset-inline-start: 14%;
    rotate: -8deg;
  }

  .band__tape--end {
    inset-inline-end: 14%;
    rotate: 6deg;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes marquee-rtl {
    to {
      transform: translateX(50%);
    }
  }
</style>
