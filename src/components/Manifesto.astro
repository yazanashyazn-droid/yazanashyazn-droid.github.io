---
// Manifesto and the ring "eyes" (pupil = YZN logo dot) with a peeking bubble.
import { Image } from 'astro:assets';
import Torn from './Torn.astro';
import { useT, type Lang } from '../i18n/ui';
import { img } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// "(words in brackets)" render in the light weight, like the reference
const chunks = t('manifesto').split(/(\([^)]*\))/).filter(Boolean);
const eyes = [{ cls: 'eye--a' }, { cls: 'eye--b' }, { cls: 'eye--c' }];
---

<section class="mani" id="services" aria-labelledby="mani-title">
  <Torn tone="cream" seed={3} />
  <div class="mani__top">
    <h2 class="mani__text display" id="mani-title" data-reveal>
      {chunks.map((c) => (c.startsWith('(') ? <span class="paren">{c}</span> : c))}
    </h2>
    <div class="mani__aside">
      <div class="mani__thumb" data-reveal>
        <Image src={img('works/nawaf/stationery.webp')} alt="" widths={[300, 600]} sizes="260px" />
      </div>
      <p class="mani__side" data-reveal>{t('manifesto.side')}</p>
    </div>
  </div>

  <div class="eyes">
    <p class="eyes__hint tech">{t('eyes.hint')}</p>
    {
      eyes.map((e) => (
        <div class={`eye ${e.cls}`} data-eye aria-hidden="true">
          <span class="eye__iris">
            <span class="eye__pupil" data-pupil>
              <span class="eye__glint" />
            </span>
          </span>
          <span class="bubble" data-bubble>
            <span class="bubble__sheen" />
          </span>
        </div>
      ))
    }
  </div>

</section>

<style>
  .mani {
    position: relative;
    padding: clamp(5rem, 10vw, 8rem) var(--gutter);
    background-color: var(--surface-cream);
    color: var(--ink-900);
    /* clip sideways only, so the torn edge can overlap the section above */
    overflow-x: clip;
  }

  .mani__top {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: var(--sp-8);
    align-items: end;
    padding-bottom: var(--sp-12);
    border-bottom: 1px dashed var(--paper-300);
  }

  .mani__text {
    font-size: clamp(2rem, 1rem + 3.6vw, 4.4rem);
    line-height: 0.98;
  }

  .mani__text:lang(ar) {
    line-height: 1.45;
  }

  .paren {
    font-family: var(--font-sans);
    font-weight: 250;
    text-transform: none;
    color: var(--accent-on-cream);
  }

  .mani__aside {
    display: grid;
    gap: var(--sp-6);
  }

  .mani__thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .mani__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .mani__thumb:hover :global(img) {
    transform: scale(1.06);
  }

  .mani__side {
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* ---------- Eyes ---------- */
  .eyes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    padding-block: var(--sp-12);
    border-bottom: 1px dashed var(--paper-300);
  }

  .eye {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1;
    justify-self: center;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: transform 0.6s var(--ease-spring);
  }

  .eye {
    overflow: hidden;
    isolation: isolate;
  }

  .eyes__hint {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    justify-self: center;
    font-size: var(--fs-xs);
    color: var(--text-on-cream-muted);
    text-align: center;
  }

  /* Clear soap bubble that follows the pointer inside an eye */
  .bubble {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 56%;
    height: 56%;
    margin: -28% 0 0 -28%;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    transform: scale(0);
    background: radial-gradient(circle at 50% 55%, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.18) 70%);
    backdrop-filter: blur(1.5px) saturate(1.3);
    box-shadow:
      inset 0 0 0 2px rgb(255 255 255 / 0.7),
      inset -12px -16px 28px rgb(62 154 175 / 0.55),
      inset 14px 10px 26px rgb(249 100 80 / 0.45),
      0 18px 30px rgb(0 0 0 / 0.25);
  }

  /* Iridescent film + highlight */
  .bubble__sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(ellipse 30% 18% at 32% 24%, rgb(255 255 255 / 0.95), transparent 70%),
      radial-gradient(circle at 70% 78%, rgb(255 255 255 / 0.35), transparent 30%),
      conic-gradient(
        from 40deg,
        rgb(249 100 80 / 0.28),
        rgb(62 154 175 / 0.3),
        rgb(249 240 233 / 0.25),
        rgb(249 100 80 / 0.28)
      );
    mix-blend-mode: screen;
  }

  .eye__iris {
    display: grid;
    place-items: center;
    width: 66%;
    height: 66%;
    border-radius: 50%;
  }

  /* The pupil is the YZN logo's coral dot */
  .eye__pupil {
    position: relative;
    width: 42%;
    height: 42%;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
  }

  .eye__glint {
    position: absolute;
    top: 18%;
    inset-inline-start: 22%;
    width: 22%;
    height: 22%;
    border-radius: 50%;
    background: var(--paper);
    opacity: 0.85;
  }

  .eye--a { grid-column: 1; background: var(--accent); }
  .eye--a .eye__iris { background: var(--ink-900); }
  .eye--b { grid-column: 3; background: var(--sticker); }
  .eye--b .eye__iris { background: var(--paper); }
  .eye--c { grid-column: 4; background: var(--ink-900); }
  .eye--c .eye__iris { background: var(--accent-2); }

  @media (max-width: 900px) {
    .mani__top {
      grid-template-columns: 1fr;
    }
    .eyes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-3);
    }
    .eye--a { grid-column: 1; }
    .eye--b { grid-column: 2; }
    .eye--c { grid-column: 3; }
    .eyes__hint {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: var(--sp-4);
    }
  }
</style>
