---
import Logo from './Logo.astro';
import { useT, contact, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const otherUrl = other === 'ar' ? base : `${base}en/`;

const links = [
  { href: '#work', label: t('nav.work') },
  { href: '#services', label: t('nav.services') },
  { href: '#about', label: t('nav.about') },
  { href: '#faq', label: t('nav.faq') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="header" data-header>
  <div class="bar">
    <a class="bar__brand" href="#top" aria-label={`YZN — ${t('nav.home')}`}>
      <Logo class="bar__logo" />
      <span class="bar__clock" aria-hidden="true">
        <span class="bar__city">{t('hero.city')}</span>
        <span class="tech" dir="ltr"><span data-clock>--:--</span> GMT+3</span>
      </span>
    </a>
    <span class="bar__fill" aria-hidden="true"></span>
    <a class="bar__tab bar__tab--1" href="#work"><span class="tech">01</span>{t('nav.work')}</a>
    <a class="bar__tab bar__tab--2" href="#about"><span class="tech">02</span>{t('nav.about')}</a>
    <a
      class="bar__lang"
      href={otherUrl}
      hreflang={other}
      lang={other}
      data-lang-switch={other}
      aria-label={t('lang.switchLabel')}>{t('lang.switch')}</a
    >
    <button
      class="bar__menu"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
      data-label-open={t('nav.menu')}
      data-label-close={t('nav.close')}
    >
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="visually-hidden" data-menu-label>{t('nav.menu')}</span>
    </button>
  </div>

  <nav class="menu" id="site-menu" aria-label={t('nav.main')} data-menu hidden>
    <div class="menu__panel">
    <p class="menu__title tech">[ {t('nav.menu')} ]</p>
    <ol class="menu__list">
      {
        links.map((l, i) => (
          <li>
            <a class="menu__link" href={l.href} data-menu-link>
              <span class="menu__num tech" aria-hidden="true">
                0{i + 1}
              </span>
              <span class="menu__label">{l.label}</span>
              <svg class="menu__arrow" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path>
              </svg>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="menu__foot">
      <p class="menu__title tech">[ {t('nav.contact')} ]</p>
      <a href={`https://wa.me/${contact.phone}`} target="_blank" rel="noopener noreferrer" dir="ltr"
        >{contact.phoneDisplay}</a
      >
      <a href={`https://instagram.com/${contact.instagram}`} target="_blank" rel="noopener noreferrer" dir="ltr"
        >@{contact.instagram}</a
      >
      <a class="menu__cta" href="#contact" data-menu-link>{t('nav.cta')}</a>
    </div>
    </div>
  </nav>
</header>

<a class="side-tab" href="#contact">
  <span class="side-tab__mark display">YZN.</span>
  <span class="side-tab__text">{t('side.available')}</span>
</a>

<style>
  .header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-header);
  }

  .bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 56px 56px;
    height: 56px;
  }

  .bar > * {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .bar__brand {
    justify-content: space-between;
    gap: var(--sp-3);
    padding-inline: var(--sp-4);
    background: var(--paper);
    color: var(--ink-900);
  }

  .bar__logo {
    width: 76px;
    color: var(--ink-900);
  }

  .bar__clock {
    display: grid;
    text-align: end;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .bar__fill {
    background: var(--ink-900);
  }

  .bar__tab {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    padding-inline: var(--sp-4);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--paper);
  }

  .bar__tab .tech {
    font-size: 0.55rem;
    opacity: 0.8;
  }

  .bar__tab--1 {
    background: var(--ink-700);
  }

  .bar__tab--2 {
    background: var(--sticker);
  }

  .bar__tab:hover {
    background: var(--accent);
    color: var(--ink-900);
  }

  .bar__lang {
    justify-content: center;
    background: var(--ink-900);
    color: var(--paper);
    font-weight: 700;
    border-inline-start: 1px solid rgb(255 255 255 / 0.1);
  }

  .bar__lang:hover {
    background: var(--paper);
    color: var(--ink-900);
  }

  .bar__menu {
    justify-content: center;
    border: 0;
    background: var(--accent);
    color: var(--ink-900);
  }

  .dots {
    display: grid;
    grid-template-columns: repeat(2, 5px);
    gap: 6px;
    transition: transform 0.5s var(--ease-spring);
  }

  .dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  [aria-expanded='true'] .dots {
    transform: rotate(45deg) scale(1.15);
  }

  .bar__menu:hover .dots {
    transform: rotate(90deg);
  }

  /* Menu: a side panel that slides out from the menu button's edge, over a dimmed page */
  .menu {
    position: fixed;
    inset: 56px 0 0 0;
    z-index: 1;
    background: rgb(22 22 22 / 0.55);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .menu[hidden] {
    display: none;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    inset-inline-end: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    width: min(420px, 100%);
    padding: var(--sp-8) var(--sp-6);
    background: var(--paper);
    color: var(--ink-900);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.6s var(--ease-out);
  }

  :global([dir='rtl']) .menu__panel {
    transform: translateX(-100%);
  }

  .menu.is-open .menu__panel {
    transform: none;
  }

  .menu__title {
    font-size: var(--fs-xs);
    color: var(--text-on-cream-muted);
  }

  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--paper-300);
  }

  .menu__link {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: 64px;
    padding-inline: var(--sp-2);
    border-bottom: 1px solid var(--paper-300);
    font-size: var(--fs-lg);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.25s,
      padding 0.35s var(--ease-out);
  }

  .menu__link:hover,
  .menu__link:focus-visible {
    background: var(--accent);
    padding-inline: var(--sp-4);
  }

  .menu__num {
    font-size: var(--fs-xs);
    color: var(--accent-on-cream);
  }

  .menu__link:hover .menu__num {
    color: var(--ink-900);
  }

  .menu__label {
    flex: 1;
  }

  .menu__arrow {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.25s, transform 0.35s var(--ease-out);
  }

  :global([dir='rtl']) .menu__arrow {
    scale: -1 1;
  }

  .menu__link:hover .menu__arrow {
    opacity: 1;
    transform: none;
  }

  .menu__foot {
    display: grid;
    gap: var(--sp-2);
    margin-top: auto;
    font-weight: 600;
  }

  .menu__foot a {
    width: fit-content;
    text-decoration: none;
  }

  .menu__foot a:hover {
    color: var(--accent-on-cream);
  }

  .menu__foot .menu__cta {
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-6);
    border-radius: var(--radius-pill);
    background: var(--ink-900);
    color: var(--paper);
  }

  .menu__foot .menu__cta:hover {
    background: var(--accent);
    color: var(--ink-900);
  }

  /* Vertical "available" tab, like the reference's award badge */
  .side-tab {
    position: fixed;
    top: 50%;
    /* Physical right in both languages; the hero reserves room for it */
    right: 0;
    z-index: calc(var(--z-header) - 1);
    display: grid;
    justify-items: center;
    gap: var(--sp-4);
    width: 44px;
    padding-block: var(--sp-3) var(--sp-4);
    transform: translateY(-50%);
    background: var(--accent);
    color: var(--ink-900);
    text-decoration: none;
    transition: width 0.4s var(--ease-spring);
  }

  .side-tab:hover {
    width: 52px;
  }

  .side-tab__mark {
    font-size: 1rem;
  }

  .side-tab__text {
    writing-mode: vertical-rl;
    font-size: var(--fs-xs);
    font-weight: 700;
    white-space: nowrap;
  }

  .side-tab__text {
    transform: rotate(180deg);
  }

  @media (max-width: 900px) {
    .menu {
      top: 52px;
    }
    .bar {
      grid-template-columns: minmax(0, 1fr) 0 0 0 52px 52px;
      height: 52px;
    }
    .bar__fill,
    .bar__tab {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .side-tab {
      display: none;
    }
  }
</style>
